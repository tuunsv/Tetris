<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <CodePage>65001</CodePage>
    <RootNamespace>Tetris118</RootNamespace>
    <AssemblyName>Tetris118</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tetris118.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="Program.cs" />
    <Compile Include="Core\*.cs" />
    <Compile Include="Data\*.cs" />
    <Compile Include="Audio\*.cs" />
    <Compile Include="UI\*.cs" />
    <Content Include="Assets\*.wav"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
